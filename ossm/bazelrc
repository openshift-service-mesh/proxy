# Common build flags

build --verbose_failures

# Toolchain configuration
build --repo_env=BAZEL_USE_HOST_SYSROOT=True

# Main C++ compile uses the host clang toolchain (@llvm_host, defined in the
# root MODULE.bazel with an exec toolchain root of /usr). extra_toolchains
# outrank the hermetic `@llvm_toolchain` Envoy registers, so this wins for the
# default host platform -- reproducing the WORKSPACE-era host build.
build --extra_toolchains=@llvm_host//:all

# Point Envoy's compat/openssl prefixer at the *host* LLVM. This does NOT change
# the main C++ toolchain (that is @llvm_host above); its effect is that Envoy's
# @envoy_repo//:compiler.bzl detects a host LLVM and makes bazel/toolchains.bzl
# select @llvm_toolchain_llvm//:lib64/libclang-cpp.so.<host-version> (+libLLVM)
# for the prefixer, plus host-shaped -isystem paths. On its own that target
# would not exist -- @llvm_toolchain_llvm is normally envoy_toolshed's hermetic
# clang-22 minimal LLVM -- so we also patch envoy_toolshed (see MODULE.bazel) to
# back @llvm_toolchain_llvm with the host /usr LLVM when this env var is set.
# Together this reproduces the WORKSPACE-era behavior: the prefixer links the
# host libclang (matching the host libstdc++) instead of a hermetic clang whose
# libstdc++ requirements the build container does not satisfy.
build --repo_env=BAZEL_LLVM_PATH=/usr
build --config=clang-common
build --config=libstdc++
build --action_env=Clang_DIR=/usr/lib64/llvm21
build --cxxopt=-Wno-nullability-completeness
build --host_linkopt=-latomic
build --linkopt=-latomic
build --features=-layering_check --host_features=-layering_check

# Build-time Python runs on the host interpreter via the local_runtime
# toolchain registered in MODULE.bazel. Do NOT add
# --extra_toolchains=@rules_python//python:autodetecting_toolchain here:
# --extra_toolchains outrank MODULE-registered toolchains, so it would displace
# the host local_runtime with the weaker autodetecting toolchain (no build-time
# interpreter info, cannot build C extensions) and re-trigger the hermetic
# CPython download.
#
# Pin the wheel-selection version to 3.12. The vendored pip wheels
# (base_pip3/fuzzing_pip3/v8_python_deps) are cp312-only, and removing the
# hermetic `python.toolchain(is_default=True, python_version="3.12")` from
# MODULE.bazel dropped the default, letting rules_python fall back to 3.11 --
# for which no wheel exists ("No matching wheel for current configuration").
# This flag only drives the wheel select()s; it fetches no interpreter (the
# host local_runtime above provides that, and must likewise be CPython 3.12).
common --@rules_python//python/config_settings:python_version=3.12

build --extra_toolchains=@local_jdk//:all
build --tool_java_runtime_version=local_jdk

# Use host-installed CMake/Make/Ninja/etc instead of building them from source.
# extra_toolchains outrank rules_foreign_cc's own built-from-source toolchain
# registrations, so the built tools are never fetched/built. Mirrors envoy's
# bazelrc.windows. Requires the direct bazel_dep on rules_foreign_cc in
# MODULE.bazel so `@rules_foreign_cc` resolves here.
build --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_autoconf_toolchain
build --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_automake_toolchain
build --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_cmake_toolchain
build --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_m4_toolchain
build --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_make_toolchain
build --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_meson_toolchain
build --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_ninja_toolchain
build --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_pkgconfig_toolchain

# OpenSSL configuration
common --config=openssl

# Test flags
build --test_env=ENVOY_IP_TEST_VERSIONS=v4only
build --test_env=HEAPCHECK=minimal
build --test_output=all

# Arch-specific build flags, triggered with --config=$ARCH in bazel build command
build:x86_64 --define=DUMMY=dummy

#build:s390x --@envoy//source/extensions/filters/common/lua:luajit2=1
build:s390x --define=DUMMY=dummy

#build:ppc --action_env=BAZEL_LINKLIBS=-lstdc++
#build:ppc --@envoy//source/extensions/filters/common/lua:luajit2=1
#build:ppc --platforms=//ppc64le_platform:host
#build:ppc --extra_execution_platforms=//ppc64le_platform:host
#build:ppc --extra_toolchains=//ppc64le_platform:jdk_runtime
build:ppc --define=DUMMY=dummy

build:aarch64 --define=DUMMY=dummy

# Colored ouput messes with some of the logging systems in CI, so we disable that.
build:ci-config --color=no
build:ci-config --show_progress_rate_limit=10

# Offline builds via bzlmod vendor mode.
# Regenerate the snapshot with ossm/scripts/update-deps.sh. Missing repos fall
# back to network fetch with a warning, so online builds keep working.
# The path is relative to the workspace root (do NOT use %workspace%, which is
# not expanded for --vendor_dir and silently disables the snapshot).
common --vendor_dir=ossm/vendor

# Override the vendored gazelle go_deps repos (pure Go source) directly from
# their vendor paths, bypassing marker validation. Their vendor markers
# transitively hash the host `go` binary, so a snapshot vendored on one arch is
# always "out-of-date" on another and Bazel tries to re-fetch them, breaking
# offline cross-arch builds. This file is generated by ossm/scripts/update-deps.sh
# (regenerated on every snapshot). try-import: it is absent while update-deps.sh
# is mid-vendor (the snapshot is wiped and rebuilt), and overrides aren't needed
# then anyway.
try-import %workspace%/ossm/vendor/go_deps_overrides.bazelrc
