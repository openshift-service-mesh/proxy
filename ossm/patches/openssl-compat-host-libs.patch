diff --git a/compat/openssl/BUILD b/compat/openssl/BUILD
index 763a91efb2..6962d2a784 100644
--- a/compat/openssl/BUILD
+++ b/compat/openssl/BUILD
@@ -9,32 +9,26 @@ licenses(["notice"])  # Apache 2
 # libcrypto.so.<major> and libssl.so.<major>.
 OPENSSL_SOVERSION = "3"
 
-# OpenSSL shared libraries, built from the @openssl module's static libraries.
-# They are only loaded at runtime with dlopen() (see source/ossl_dlutil.c), so
-# they are a *data* dependency of :bssl-compat, never a link dependency.
-cc_shared_library(
-    name = "libcrypto",
-    shared_lib_name = "libcrypto.so." + OPENSSL_SOVERSION,
-    user_link_flags = ["-Wl,-soname,libcrypto.so." + OPENSSL_SOVERSION],
-    visibility = ["//visibility:private"],
-    deps = ["@openssl//:crypto"],
-)
-
-cc_shared_library(
-    name = "libssl",
-    dynamic_deps = [":libcrypto"],
-    shared_lib_name = "libssl.so." + OPENSSL_SOVERSION,
-    user_link_flags = ["-Wl,-soname,libssl.so." + OPENSSL_SOVERSION],
-    visibility = ["//visibility:private"],
-    deps = ["@openssl//:ssl"],
+# OSSM: the OpenSSL shared libraries used at runtime (dlopen'd from
+# source/ossl_dlutil.c) as a *data* dependency of :bssl-compat. Upstream builds
+# these with cc_shared_library from @openssl's static libraries; OSSM replaces
+# the @openssl module with the host's OpenSSL, which ships only precompiled
+# dynamic libraries (no static archives to relink). So we stage the host's
+# existing libcrypto.so.<major> / libssl.so.<major> into this package instead,
+# which puts them at the OSSL_RUNFILES_LIB_DIR path :bssl-compat expects.
+genrule(
+    name = "openssl_libs_copy",
+    srcs = ["@openssl//:libs"],
+    outs = [
+        "libcrypto.so." + OPENSSL_SOVERSION,
+        "libssl.so." + OPENSSL_SOVERSION,
+    ],
+    cmd = "for f in $(SRCS); do cp \"$$f\" \"$(RULEDIR)/$$(basename \"$$f\")\"; done",
 )
 
 filegroup(
     name = "openssl_libs",
-    srcs = [
-        ":libcrypto",
-        ":libssl",
-    ],
+    srcs = [":openssl_libs_copy"],
     visibility = ["//visibility:private"],
 )
 
