+# Matches the lib/libclang-cpp.so* / lib/libLLVM.so* / lib/libclang.so* entries
+# of LLVM_MINIMAL_LIB_GLOBS.
+_HOST_LLVM_SHARED_LIB_PREFIXES = [
+    "libclang-cpp.so",
+    "libLLVM.so",
+    "libclang.so",
+]
