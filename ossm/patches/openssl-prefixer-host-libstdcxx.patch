--- a/compat/openssl/prefixer/BUILD
+++ b/compat/openssl/prefixer/BUILD
@@ -3,22 +3,8 @@
 
 licenses(["notice"])  # Apache 2
 
-# GCC's libstdc++ for the prefixer, from a hermetic GCC repository that a host GCC override does
-# not replace. It is available when Envoy is a dependency too; set this flag to use another.
-# The default follows the CPU the prefixer is built for: libstdc++.a must match its architecture.
-alias(
-    name = "libstdcxx_default",
-    actual = select({
-        "@platforms//cpu:aarch64": "@gcc_runtime_linux_aarch64//:libstdcxx",
-        "//conditions:default": "@gcc_runtime_linux_x86_64//:libstdcxx",
-    }),
-)
-
-label_flag(
-    name = "libstdcxx",
-    build_setting_default = ":libstdcxx_default",
-)
-
+# OSSM: use the host LLVM toolchain's libstdc++ headers and static runtime.
+# The hermetic GCC runtime is unavailable on s390x and ppc64le.
 cc_binary(
     name = "prefixer",
     srcs = ["prefixer.cpp"],
@@ -27,23 +13,16 @@
     ] + ([LIBLLVM] if LIBLLVM else []),
     copts = [
         "-fno-rtti",  # Required by libclang-cpp
-        # Use the hermetic GCC toolchain's libstdc++ (headers via :libstdcxx) for ABI
-        # compatibility with libclang-cpp, not the toolchain's libc++. With -nostdinc++
-        # the toolchain's -stdlib=libc++ has no effect, so silence its warning.
-        "-nostdinc++",
-        "-Wno-unused-command-line-argument",
+        # Use the host libstdc++ for ABI compatibility with libclang-cpp.
+        "-stdlib=libstdc++",
     ],
     linkopts = [
         "$(location " + LIBCLANG_CPP + ")",
     ] + (["$(location " + LIBLLVM + ")"] if LIBLLVM else []) + [
         "-Wl,-rpath,$$ORIGIN/../lib",
-        # libstdc++.a comes from :libstdcxx (statically, so the tool does not need the host's
-        # libstdc++.so.6); stop the driver adding its own C++ library.
-        "-nostdlib++",
+        # The host toolchain supplies the static libstdc++ runtime.
+        "-stdlib=libstdc++",
     ],
     visibility = ["//visibility:public"],
-    deps = [
-        ":libstdcxx",
-        "@llvm_toolchain_llvm//:clang_tooling_headers",
-    ],
+    deps = ["@llvm_toolchain_llvm//:clang_tooling_headers"],
 )
