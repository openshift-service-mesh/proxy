load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "driverutil",
    srcs = [
        "fix.go",
        "print.go",
        "readfile.go",
        "url.go",
        "validatefix.go",
    ],
    importpath = "golang.org/x/tools/internal/analysis/driverutil",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
    deps = [
        "//go/analysis",
        "//go/ast/astutil",
        "//internal/astutil/free",
        "//internal/diff",
    ],
)

alias(
    name = "go_default_library",
    actual = ":driverutil",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

go_test(
    name = "driverutil_test",
    srcs = ["url_test.go"],
    deps = [
        ":driverutil",
        "//go/analysis",
    ],
)
