load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "analyzerutil",
    srcs = [
        "doc.go",
        "extractdoc.go",
        "readfile.go",
        "version.go",
    ],
    importpath = "golang.org/x/tools/internal/analysis/analyzerutil",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
    deps = [
        "//go/analysis",
        "//internal/packagepath",
        "//internal/stdlib",
        "//internal/versions",
    ],
)

alias(
    name = "go_default_library",
    actual = ":analyzerutil",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

go_test(
    name = "analyzerutil_test",
    srcs = ["extractdoc_test.go"],
    deps = [":analyzerutil"],
)
