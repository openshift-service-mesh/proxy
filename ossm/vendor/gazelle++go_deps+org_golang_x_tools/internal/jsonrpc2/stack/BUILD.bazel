load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "stack",
    srcs = [
        "parse.go",
        "process.go",
        "stack.go",
    ],
    importpath = "golang.org/x/tools/internal/jsonrpc2/stack",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

alias(
    name = "go_default_library",
    actual = ":stack",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

go_test(
    name = "stack_test",
    srcs = ["stack_test.go"],
    deps = [":stack"],
)
