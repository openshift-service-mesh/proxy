load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "jsonrpc2_v2",
    srcs = [
        "conn.go",
        "frame.go",
        "jsonrpc2.go",
        "messages.go",
        "net.go",
        "serve.go",
        "wire.go",
    ],
    importpath = "golang.org/x/tools/internal/jsonrpc2_v2",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

alias(
    name = "go_default_library",
    actual = ":jsonrpc2_v2",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

go_test(
    name = "jsonrpc2_v2_test",
    srcs = [
        "jsonrpc2_test.go",
        "serve_test.go",
        "wire_test.go",
    ],
    deps = [":jsonrpc2_v2"],
)
