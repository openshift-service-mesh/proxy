load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "packagestest",
    srcs = [
        "expect.go",
        "export.go",
        "gopath.go",
        "modules.go",
    ],
    importpath = "golang.org/x/tools/internal/packagestest",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
    deps = [
        "//go/packages",
        "//internal/astutil",
        "//internal/expect",
        "//internal/gocommand",
        "//internal/proxydir",
        "//internal/testenv",
    ],
)

alias(
    name = "go_default_library",
    actual = ":packagestest",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

go_test(
    name = "packagestest_test",
    srcs = [
        "expect_test.go",
        "export_test.go",
        "gopath_test.go",
        "modules_test.go",
    ],
    deps = [
        ":packagestest",
        "//internal/astutil",
        "//internal/expect",
    ],
)
