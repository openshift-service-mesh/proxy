load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "gomodindex_lib",
    srcs = ["cmd.go"],
    importpath = "golang.org/x/tools/internal/modindex/gomodindex",
    visibility = ["//visibility:private"],
    deps = ["//internal/modindex"],
)

go_binary(
    name = "gomodindex",
    embed = [":gomodindex_lib"],
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)
