load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "packagepath",
    srcs = ["packagepath.go"],
    importpath = "golang.org/x/tools/internal/packagepath",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

alias(
    name = "go_default_library",
    actual = ":packagepath",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

go_test(
    name = "packagepath_test",
    srcs = ["packagepath_test.go"],
    deps = [":packagepath"],
)
