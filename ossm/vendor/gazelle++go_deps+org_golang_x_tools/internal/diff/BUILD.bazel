load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "diff",
    srcs = [
        "diff.go",
        "merge.go",
        "ndiff.go",
        "unified.go",
    ],
    importpath = "golang.org/x/tools/internal/diff",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
    deps = ["//internal/diff/lcs"],
)

alias(
    name = "go_default_library",
    actual = ":diff",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

go_test(
    name = "diff_test",
    srcs = [
        "diff_test.go",
        "export_test.go",
        "merge_test.go",
    ],
    embed = [":diff"],
    deps = [
        "//internal/diff/difftest",
        "//internal/testenv",
    ],
)
