load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "hello_lib",
    srcs = ["main.go"],
    importpath = "golang.org/x/tools/internal/mcp/examples/hello",
    visibility = ["//visibility:private"],
    deps = ["//internal/mcp"],
)

go_binary(
    name = "hello",
    embed = [":hello_lib"],
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)
