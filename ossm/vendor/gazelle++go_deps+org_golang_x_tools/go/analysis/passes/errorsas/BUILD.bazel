load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "errorsas",
    srcs = ["errorsas.go"],
    importpath = "golang.org/x/tools/go/analysis/passes/errorsas",
    visibility = ["//visibility:public"],
    deps = [
        "//go/analysis",
        "//internal/analysis/typeindex",
        "//internal/typesinternal/typeindex",
