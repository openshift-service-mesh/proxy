load("@@envoy_toolshed+//pgp:defs.bzl", "pgp_toolchain", "sq_signer")

sq_signer(
    name = "linux_aarch64_signer",
    sq = "@@envoy_toolshed++sq_prebuilt_extension+sq_prebuilt_linux_aarch64//:sq",
)

pgp_toolchain(
    name = "linux_aarch64_impl",
    signer = ":linux_aarch64_signer",
)

toolchain(
    name = "linux_aarch64",
    toolchain = ":linux_aarch64_impl",
    toolchain_type = "@@envoy_toolshed+//pgp:toolchain_type",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

sq_signer(
    name = "linux_x86_64_signer",
    sq = "@@envoy_toolshed++sq_prebuilt_extension+sq_prebuilt_linux_x86_64//:sq",
)

pgp_toolchain(
    name = "linux_x86_64_impl",
    signer = ":linux_x86_64_signer",
)

toolchain(
    name = "linux_x86_64",
    toolchain = ":linux_x86_64_impl",
    toolchain_type = "@@envoy_toolshed+//pgp:toolchain_type",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
