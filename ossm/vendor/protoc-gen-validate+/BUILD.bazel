load("//bazel:prebuilt.bzl", "PREBUILT_PLATFORMS", "prebuilt_binary", "prebuilt_repo_name")

# The protoc plugin is the prebuilt binary from the upstream release for the
# platform it runs on, rather than a go_binary: building it from source pulls
# the Go toolchain, gazelle and the plugin's Go dependencies into every build
# that generates validators. See bazel/prebuilt.bzl.
[
    config_setting(
        name = "prebuilt_" + platform,
        constraint_values = info.constraints,
    )
    for platform, info in PREBUILT_PLATFORMS.items()
]

prebuilt_binary(
    name = "protoc-gen-validate",
    binary = select({
        ":prebuilt_" + platform: "@{}//:{}".format(prebuilt_repo_name(platform), info.binary)
        for platform, info in PREBUILT_PLATFORMS.items()
    }),
    visibility = ["//visibility:public"],
)
