    dictionary = "@@envoy_toolshed++hunspell_prebuilt_extension+hunspell_prebuilt_linux_aarch64//:share/hunspell/en_US.dic",
    hunspell = "@@envoy_toolshed++hunspell_prebuilt_extension+hunspell_prebuilt_linux_aarch64//:hunspell",
