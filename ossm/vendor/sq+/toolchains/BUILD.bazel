load("//:defs.bzl", "sq_toolchain")

package(default_visibility = ["//visibility:public"])

sq_toolchain(
    name = "prebuilt_linux_x86_64_impl",
    sq = "@sq_prebuilt_linux_x86_64//:bin/sq",
)

toolchain(
    name = "prebuilt_linux_x86_64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":prebuilt_linux_x86_64_impl",
    toolchain_type = "//:toolchain_type",
)

sq_toolchain(
    name = "prebuilt_linux_aarch64_impl",
    sq = "@sq_prebuilt_linux_aarch64//:bin/sq",
)

toolchain(
    name = "prebuilt_linux_aarch64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = ":prebuilt_linux_aarch64_impl",
    toolchain_type = "//:toolchain_type",
)

sq_toolchain(
    name = "from_source_impl",
    sq = "//:sq_from_source",
)

toolchain(
    name = "from_source",
    toolchain = ":from_source_impl",
    toolchain_type = "//:toolchain_type",
)
